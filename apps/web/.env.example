# Copy to .env.local and mirror in the hosting env settings. Marketing owns these values.
# Every value is public: never put a secret in a NEXT_PUBLIC_ variable.
# Values are inlined at build time, so a change needs a redeploy.

# Used for absolute links in social previews, e.g. https://nairobielitehomes.co.ke
NEXT_PUBLIC_SITE_URL=""

# --- Community / Conversion (required: the build fails if these are missing or invalid) ---
NEXT_PUBLIC_WHATSAPP_GROUP_URL="https://chat.whatsapp.com/XXXXXXXXXXXX"
NEXT_PUBLIC_WHATSAPP_DIRECT_URL="https://wa.me/2547XXXXXXXX"
# Master switch for urgency copy and CTA destinations: founding | paid | waitlist | closed
# Only founding links to the group. In the others the link is left out of the site entirely,
# and "closed" tells visitors to contact an admin for it.
NEXT_PUBLIC_COMMUNITY_STATUS="founding"

# --- Community numbers (optional: leave empty until you have real figures) ---
# Copy that depends on a number is dropped while the number is empty.
# Community Settings in Sanity overrides these without a deploy.
NEXT_PUBLIC_COMMUNITY_MEMBER_COUNT=""
NEXT_PUBLIC_COMMUNITY_CAP=""
NEXT_PUBLIC_COMMUNITY_PAID_PRICE_KES=""
NEXT_PUBLIC_COMMUNITY_PAID_PRICE_USD=""

# --- Social (optional: an empty value hides that link) ---
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""

# --- Contact (optional) ---
NEXT_PUBLIC_SALES_EMAIL=""
NEXT_PUBLIC_PHONE=""

# --- Security check (public site key, used by the lead form) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ----------------------------------------------------------------------------
# SERVER ONLY: secrets below must never get a NEXT_PUBLIC_ prefix.
# ----------------------------------------------------------------------------

# --- Google Search Console: the content value of its HTML verification tag. ---
GOOGLE_SITE_VERIFICATION=""

# --- Sanity. While SANITY_PROJECT_ID is empty, the site shows sample listings. ---
# The dataset MUST be private, or off-market listings can be read from Sanity's API.
SANITY_PROJECT_ID=""
SANITY_DATASET="production"
SANITY_API_READ_TOKEN=""
# Sent by the Sanity webhook as "Authorization: Bearer <secret>" to /api/revalidate.
SANITY_REVALIDATE_SECRET=""

# --- Admin accounts. See docs/admin-accounts.md. Until DATABASE_URL is set, /admin is unavailable. ---
DATABASE_URL=""
# Used only by "pnpm seed-admins". Temporary passwords are generated and printed once.
SEED_SUPERADMIN_EMAIL=""
SEED_ADMIN_1_EMAIL=""
SEED_ADMIN_2_EMAIL=""

# --- Sign in with Google. Free sign-in for buyers, and optional for staff. See docs/admin-accounts.md. ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Photo uploads for reviewers (Vercel Blob). Without it, reviewers paste photo links. ---
BLOB_READ_WRITE_TOKEN=""

# --- Lead form. In production the form refuses submissions until all of these are set. ---
TURNSTILE_SECRET_KEY=""
RESEND_API_KEY=""
LEAD_EMAIL_TO=""
LEAD_EMAIL_FROM=""

# --- Morning acquisition job. See docs/acquisition.md. Also needs DATABASE_URL. ---
# Reports always appear on the SuperAdmin's dashboard, and the SuperAdmin picks who gets them by
# email there. Email also needs RESEND_API_KEY and LEAD_EMAIL_FROM.
# Random, 16+ characters. Vercel sends it to the cron routes. With none set, the job can't start.
CRON_SECRET=""
# Research stays off unless this is exactly "on". On also needs the next two.
ACQUISITION_RESEARCH_ENABLED=""
ANTHROPIC_API_KEY=""
# Random, 32+ characters. Keys the suppression list's hashes. Never change it once set, or opt-outs stop matching.
ACQUISITION_HASH_KEY=""
# Optional: most it may spend on search and Claude in a day, in US dollars. Defaults to 3.
ACQUISITION_DAILY_SPEND_USD=""
# Optional: comma-separated, who hears if a report fails. Defaults to the report's recipients.
ACQUISITION_ALERT_EMAIL_TO=""
# Optional but recommended: a dead-man's-switch URL pinged after each delivered report.
ACQUISITION_MONITOR_URL=""
